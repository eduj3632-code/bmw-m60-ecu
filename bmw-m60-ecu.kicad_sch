(cell 1 0 0 "MODULES" "Hellen-One Module References"
  # Module references on this sheet
  # MCU: mega-mcu144 (STM32H144, center of board)
  # VR: vr module (4x VR conditioning, top center)
  # WBO: wbo module (2x wideband, top right)
  # Power: power12-and-5 (left side, 5V/12V regulation)
  # Output: output + ign8 (bottom center, injectors + coils)
  # CAN: can module (right side, transceiver + connector)
  # Input: dinput4 + knock (left side, TPS/MAP/IAT/CLT/OIL/knock)
  # Connectors: 144-pin automotive edge connector
)
